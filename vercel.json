{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "installCommand": "npm install",
  "routes": [
    { "src": "/services/laser-surgery", "status": 308, "headers": { "Location": "/services/surgery" } },
    { "src": "/services/therapy", "status": 308, "headers": { "Location": "/services/microscope-treatment" } },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
